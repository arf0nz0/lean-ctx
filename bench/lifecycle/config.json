{
  "lanes": ["beets", "fastify", "terraform"],
  "arms": ["leanctx", "bare"],
  "agent": {
    "binary": "codex",
    "subcommand": "exec",
    "sandbox": "workspace-write",
    "extra_flags": [
      "--dangerously-bypass-approvals-and-sandbox",
      "--dangerously-bypass-hook-trust",
      "--ephemeral"
    ]
  },
  "leanctx": {
    "binary": "lean-ctx",
    "init_args": ["init", "--agent", "codex"]
  },
  "timeouts": {
    "task_seconds": 600,
    "setup_seconds": 300
  },
  "runs_dir": "runs",
  "repo_cache_dir": ".cache/repos"
}
